# Security headers for the static storefront (Cloudflare Pages).
#
# The API sets the same baseline on JSON responses; the HTML bundle had none, so a
# phishing page could frame the storefront and the browser would sniff content types.
# A Content-Security-Policy is deliberately not set here: MUI injects styles at runtime
# and GA adds two script origins, so it needs a browser-tested policy of its own.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Crawler files are generated by scripts/generate-seo.mjs after the Vite build. Without an
# explicit type the SPA fallback could otherwise answer them with the HTML shell.
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

# Guide covers, copied out of the API and into the deployment by scripts/generate-seo.mjs.
# They are static files on purpose: a cover is the Largest Contentful Paint element on a
# guide page, and Cloudflare serves a static file from its shared cache even to a datacentre
# that has never requested it, where a proxied read would have to wake the API first. The
# name is the product id rather than a content hash, so a re-rendered cover reaches a
# returning visitor within the day instead of needing a new URL.
/art/*
  Cache-Control: public, max-age=86400
