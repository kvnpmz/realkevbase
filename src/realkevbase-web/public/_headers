# Security headers for the static storefront (Cloudflare Pages).
#
# The API sets the same baseline on JSON responses; the HTML bundle had none, so a
# phishing page could frame the storefront and the browser would sniff content types.
# A Content-Security-Policy is deliberately not set here: MUI injects styles at runtime
# and GA adds two script origins, so it needs a browser-tested policy of its own.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Crawler files are generated by scripts/generate-seo.mjs after the Vite build. Without an
# explicit type the SPA fallback could otherwise answer them with the HTML shell.
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600
